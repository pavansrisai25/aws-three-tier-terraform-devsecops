
flowchart TB
    Internet["Internet"]
    IGW["Internet Gateway"]

    subgraph VPC["VPC - 10.0.0.0/16"]
        subgraph PUBLIC["Public Subnets - 2 AZs"]
            ALB["Public Application Load Balancer"]
            WEBTG["Public Web Target Group"]
            WEBASG["Web Auto Scaling Group"]
            WEBINST["Web ASG EC2 Instances"]
            NAT["NAT Gateway"]
        end

        subgraph PRIVATEAPP["Private Application Subnets - 2 AZs"]
            EC2A["Standalone EC2 Web A"]
            EC2B["Standalone EC2 Web B"]
            IALB["Internal Application Load Balancer"]
            APPTG["Application Target Group"]
            APPASG["Application Auto Scaling Group"]
            APPINST["Application EC2 Instances"]
        end

        subgraph PRIVATEDB["Private Database Subnets - 2 AZs"]
            DBA["Database Subnet A"]
            DBB["Database Subnet B"]
        end

        RDSGROUP["RDS Subnet Group - 4 Subnets"]
        RDS["Amazon RDS MySQL - Single AZ"]
    end

    Internet --> IGW
    IGW --> ALB

    ALB --> WEBTG
    WEBTG --> EC2A
    WEBTG --> EC2B
    WEBTG --> WEBASG
    WEBASG --> WEBINST

    WEBINST --> IALB
    IALB --> APPTG
    APPTG --> APPASG
    APPASG --> APPINST
    APPINST --> RDS

    DBA -.-> RDSGROUP
    DBB -.-> RDSGROUP
    RDSGROUP -.-> RDS

    PRIVATEAPP -. Outbound traffic .-> NAT
    NAT --> IGW
